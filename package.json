{
  "name": "@neomei/opencode-feishu",
  "version": "0.5.16",
  "description": "Node.js-native Feishu/Lark bridge for OpenCode — production-grade daemon, persistence, preflight, structured logs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "opencode-feishu": "bin/opencode-feishu"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "opencode",
    "feishu",
    "lark",
    "bridge",
    "ai",
    "chatbot",
    "messaging",
    "agent",
    "multi-agent"
  ],
  "author": "neomei",
  "license": "MIT",
  "homepage": "https://github.com/NeoMei/opencode-feishu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeoMei/opencode-feishu.git"
  },
  "bugs": {
    "url": "https://github.com/NeoMei/opencode-feishu/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.63.1",
    "@neomei/opencode-feishu": "^0.3.3",
    "@opencode-ai/sdk": "^1.0.0",
    "@types/qrcode": "^1.5.6",
    "commander": "^11.0.0",
    "inquirer": "^9.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
